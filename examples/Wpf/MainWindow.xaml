<Window x:Class="ProgDemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Подключение" Width="1120" Height="760"
        MinWidth="760" MinHeight="520" FontFamily="Calibri" FontSize="16" Language="ru-RU"
        Background="White" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="#D2F6E7"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#70B2AF"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="140"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <StackPanel x:Name="ConnectionPanel" Width="390" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Подключение к PostgreSQL" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
      <Label Target="{Binding ElementName=ServerBox}" Content="Сервер"/>
      <TextBox x:Name="ServerBox" Text="127.0.0.1"/>
      <Label Target="{Binding ElementName=PortBox}" Content="Порт"/>
      <TextBox x:Name="PortBox" Text="5432"/>
      <Label Target="{Binding ElementName=DatabaseBox}" Content="Учебная база"/>
      <TextBox x:Name="DatabaseBox" Text="prog_demo_sample"/>
      <Label Target="{Binding ElementName=DatabaseUserBox}" Content="Пользователь PostgreSQL"/>
      <TextBox x:Name="DatabaseUserBox" Text="postgres"/>
      <Label Target="{Binding ElementName=PasswordBox}" Content="Пароль PostgreSQL"/>
      <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,0,8,12"/>
      <Button Style="{StaticResource Primary}" Content="Подключиться" Click="Connect_Click" IsDefault="True"/>
    </StackPanel>
    <DockPanel x:Name="Workspace" Visibility="Collapsed">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock x:Name="IdentityText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <Image x:Name="Logo" DockPanel.Dock="Left" Width="62" Height="44" Stretch="Uniform" Margin="0,0,12,0"/>
        <TextBlock Text="Чудо Обувь" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
      <WrapPanel DockPanel.Dock="Top">
        <Label Target="{Binding ElementName=LoginBox}" Content="Логин покупателя"/>
        <TextBox x:Name="LoginBox" Width="150" KeyDown="LoginBox_KeyDown"/>
        <Button Content="Войти" Click="Login_Click"/>
        <Button Content="Как гость" Click="Guest_Click"/>
        <Button Content="Каталог" Click="Catalog_Click"/>
        <Button x:Name="BasketButton" Content="Мой заказ" Click="Basket_Click"/>
        <Button x:Name="OrdersButton" Content="Заказы клиентов" Click="Orders_Click"/>
      </WrapPanel>
      <Grid>
        <Grid x:Name="CatalogView">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,12,0">
            <WrapPanel DockPanel.Dock="Top">
              <TextBox x:Name="SearchBox" Width="190" AutomationProperties.Name="Название или описание" TextChanged="FiltersChanged"/>
              <ComboBox x:Name="CategoryBox" AutomationProperties.Name="Категория" SelectionChanged="FiltersChanged"/>
              <ComboBox x:Name="SortBox" AutomationProperties.Name="Сортировка цены" SelectionChanged="FiltersChanged">
                <ComboBoxItem Content="Цена по возрастанию"/>
                <ComboBoxItem Content="Цена по убыванию"/>
              </ComboBox>
              <Button Content="Обновить" Click="Catalog_Click"/>
            </WrapPanel>
            <TextBlock x:Name="CatalogStatus" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <ListBox x:Name="CatalogList" SelectionChanged="CatalogSelectionChanged"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2" Background="{Binding Background}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                    <Image Source="{Binding Photo}" Height="65" Stretch="Uniform" Margin="4"/>
                    <StackPanel Grid.Column="1" Margin="6">
                      <TextBlock Text="{Binding Heading}" FontWeight="Bold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding PriceText}" VerticalAlignment="Center"
                               TextWrapping="Wrap" FontWeight="Bold" Margin="5"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Карточка модели" FontSize="20" FontWeight="Bold"/>
              <Image x:Name="ProductPhoto" Height="120" Stretch="Uniform" Margin="0,8"/>
              <TextBlock x:Name="ProductText" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock x:Name="SizeText" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <Label Target="{Binding ElementName=SizeBox}" Content="Размер"/>
              <ComboBox x:Name="SizeBox" DisplayMemberPath="Size"/>
              <Label Target="{Binding ElementName=QuantityBox}" Content="Количество"/>
              <TextBox x:Name="QuantityBox" Text="1"/>
              <Button x:Name="AddButton" Style="{StaticResource Primary}" Content="Добавить в заказ" Click="Add_Click"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <DockPanel x:Name="BasketView" Visibility="Collapsed">
          <TextBlock DockPanel.Dock="Top" Text="Оформление заказа" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
          <WrapPanel DockPanel.Dock="Top">
            <Label Target="{Binding ElementName=CustomerBox}" Content="Клиент"/>
            <ComboBox x:Name="CustomerBox" DisplayMemberPath="FullName" SelectionChanged="CustomerChanged"/>
          </WrapPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="BasketTotal" FontWeight="Bold" Margin="0,0,0,8"/>
            <WrapPanel>
              <Label Target="{Binding ElementName=EditQuantityBox}" Content="Количество"/>
              <TextBox x:Name="EditQuantityBox" Width="70"/>
              <Button Content="Изменить количество" Click="ChangeQuantity_Click"/>
              <Button Content="Удалить позицию" Click="RemoveLine_Click"/>
              <Button Content="Назад к выбору" Click="Catalog_Click"/>
              <Button Content="Отказаться" Click="CancelBasket_Click"/>
              <Button Style="{StaticResource Primary}" Content="Подтвердить заказ" Click="Confirm_Click"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="BasketGrid" SelectionChanged="BasketSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Размер" Binding="{Binding Size}"/>
              <DataGridTextColumn Header="Остаток" Binding="{Binding Available}"/>
              <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"/>
              <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}"/>
              <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <Grid x:Name="OrdersView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <Button Content="Назад к каталогу" Click="Catalog_Click"/>
            <Button Style="{StaticResource Primary}" Content="Добавить заказ из каталога" Click="Catalog_Click"/>
            <Button Content="Удалить заказ" Click="DeleteOrder_Click"/>
          </WrapPanel>
          <DataGrid x:Name="OrdersGrid" Grid.Row="1" SelectionChanged="OrderSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="№ заказа" Binding="{Binding Id}"/>
              <DataGridTextColumn Header="Дата заказа" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}"/>
              <DataGridTextColumn Header="ФИО клиента" Binding="{Binding Customer}" Width="*"/>
              <DataGridTextColumn Header="Итого, ₽" Binding="{Binding Total, StringFormat=N2}"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="OrderSummary" Grid.Row="2" Text="Состав заказа" FontWeight="Bold" Margin="0,0,0,8"/>
          <DataGrid x:Name="LinesGrid" Grid.Row="3">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Модель" Binding="{Binding Product}" Width="*"/>
              <DataGridTextColumn Header="Производство" Binding="{Binding Manufacturer}"/>
              <DataGridTextColumn Header="Размер" Binding="{Binding Size}"/>
              <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"/>
              <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}"/>
              <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel x:Name="AdminActions" Grid.Row="4">
            <Label Target="{Binding ElementName=OrderDateBox}" Content="Новая дата"/>
            <DatePicker x:Name="OrderDateBox" Width="145" Margin="0,0,8,8"/>
            <Button Content="Изменить дату" Click="ChangeDate_Click"/>
            <Button Content="Удалить позицию" Click="DeleteOrderLine_Click"/>
          </WrapPanel>
        </Grid>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
